# Copy to .env.local for local development, and set the same names in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# --- Supabase (required) --------------------------------------------------
# Project Settings → API (or Data API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site (required) ------------------------------------------------------
# No trailing slash. Production: https://community.titofinance.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Paystack (payments; test mode while demoing) -------------------------
# Dashboard → Settings → API Keys & Webhooks. Use the sk_test_ key for the
# demo. The same key signs webhooks, so there is no separate webhook secret.
PAYSTACK_SECRET_KEY=

# --- Resend (email: invites, sign-in alerts, pick teasers) ----------------
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Tito Circle <circle@titofinance.com>"
EMAIL_FROM=
# Comma-separated. Every publish is announced here at once.
ADMIN_ALERT_EMAILS=

# --- Web push (pick alerts) -----------------------------------------------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services: mailto:you@titofinance.com
VAPID_SUBJECT=

# --- Scheduled jobs --------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/alerts.
# Any long random string, e.g.: openssl rand -hex 32
CRON_SECRET=

# --- Seed script only (npm run seed) --------------------------------------
# Your own inbox. Admin = this address; demo members = plus-addresses of it.
SEED_EMAIL=
